<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Azara</title>
  <link href="assets/css/bootstrap.css" rel="stylesheet" type="text/css"/>
</head>
<body>
  <div class="container">
    <h2 style="text-align: center;"></h2>
  </div>
  <div class="container" style="text-align: right;">
    <!-- Add Product -->
    <form action="/save" method="post">
      <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="addProductModalLabel">Add Product</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="form-group" style="margin-bottom: 10px;">
                  <input type="text" id="addProductInput" name="code" class="form-control" placeholder="Product Code">
              </div>

              <div class="form-group" style="margin-bottom: 10px;">
                  <input type="text" name="warehouse_code" class="form-control" placeholder="Warehouse Code">
              </div>

              <div class="form-group" style="margin-bottom: 10px;">
                  <input type="text" id="quantity" name="quantity" class="form-control" placeholder="Quantity">
              </div>

              <div class="form-group" style="margin-bottom: 10px;">
                  <input type="text" id="created_date" name="created_date" class="form-control">
              </div>

              <div class="form-group" style="margin-bottom: 10px;">
                  <textarea name="description" class="form-control" placeholder="Description"></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary">Confirm</button>
            </div>
          </div>
        </div>
      </div>
    </form>
    <!-- Add Product End -->
    <!-- Search Product -->
    <form action="/search_product_by_code" method="post">
      <!-- Search Product -->
      <div class="modal fade" id="searchProductModal" tabindex="-1" aria-labelledby="searchProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="searchProductModalLabel">Search Product</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="form-group" style="margin-bottom: 10px;">
                  <input type="text" name="code" id="searchProductInput" class="form-control" placeholder="Product Code">
              </div>
              <div class="form-group" style="margin-bottom: 10px;">
                  <input type="text" name="warehouse_code" id="searchWarehouse" class="form-control" placeholder="Warehouse Code">
              </div>
              <p style="text-align: left;">OR by Multiple Codes</p>
              <div class="form-group" style="margin-bottom: 10px;" >
                  <input type="text" name="codes" id="codes" class="form-control" placeholder="Product Codes, example:MA1,MA2,... comma is important">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary">Confirm</button>
            </div>
          </div>
        </div>
      </div>
    </form>
    <!-- Search End -->
    <!-- Download PDF -->
    <div class="modal fade" id="downloadPDFModal" tabindex="-1" aria-labelledby="downloadPDFModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="downloadPDFModalLabel">Download PDF</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-footer" style="text-align: left; display: block">
            <div class="row">
              <div class="col-md-6">
                <form action="/download_product_pdf" method="post">
                  <input type="submit" class="btn btn-primary form-control" value="All">
                  <input type="hidden" name="download_all" value="all">
                </form>
              </div>
              <div class="col-md-6">
                <form action="/download_product_pdf" method="post">
                  <input type="submit" class="btn btn-primary form-control" value="Exclude 0 stock balance">
                </form>
              </div>
            </div>
              <div class="col-md-6">
                <form action="/download_product_pdf_by_warehouse_code" method="post">
                  <input type="text" name="warehouse_code" class="form-control" placeholder="Enter Warehouse Code">
                  <input type="submit" class="btn btn-primary form-control" value="Download">
                </form>
              </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Download PDF End-->
  </div>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-sm-6">
        <h3>Product List</h3>
      </div>
      <div class="col-sm-6">
        <div class="d-flex justify-content-end">
          <button type="button" id="add_product" class="btn btn-primary me-1" data-bs-toggle="modal" data-bs-target="#addProductModal">
            Add Product
          </button>
          <button type="button" class="btn btn-primary me-1" data-bs-toggle="modal" data-bs-target="#searchProductModal">
            Search Product
          </button>
          <button type="button" id="download_pdf" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#downloadPDFModal">
            Download PDF
          </button>
        </div>
      </div>
    </div>
    <p>Clear search product fields to refresh table</p>
    <ul class="pagination justify-content-center pagination-list">
        <li class="page-item {{#unless hasPrevious}}disabled{{/unless}}">
            <a class="page-link" href="?page={{minus currentPage 1}}" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
                <span class="visually-hidden">Previous</span>
            </a>
        </li>

        {{#each pageArray}}
            <li class="page-item {{#ifCond this ../currentPage}}active{{/ifCond}}">
                <a class="page-link" href="?page={{this}}">{{this}}</a>
            </li>
        {{/each}}

        <li class="page-item {{#unless hasNext}}disabled{{/unless}}">
            <a class="page-link" href="?page={{plus currentPage 1}}" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
                <span class="visually-hidden">Next</span>
            </a>
        </li>
    </ul>
    <table class="table table-striped" style="font-size: 20px">
      <thead>
        <tr>
          <th>Code</th>
          <th>Warehouse</th>
          <th>Stock Balance</th>
          <th>Description</th>
          <th>Added Date</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each products}}
        <tr>
          <td>{{ code }}</td>
          <td>{{ warehouse_code }}</td>
          <td>{{ formatNumber quantity }}</td>
          <td>{{ description }}</td>
          <td>{{ created_date }}</td>
          <td>
            <div class="btn-group" role="group">
              <div class="col-md-6" style="padding-right: 5px;">
                <form action="/view_product" method="post">
                  <input type="submit" class="btn btn-secondary btn-sm" class="form-control" value="View">
                  <input type="hidden" name="code" value='{{ code }}'>
                  <input type="hidden" name="id" value='{{ id }}'>
                </form>
              </div>
              <div class="col-md-6">
                <button type="button" id="update_product_{{@index}}" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#UpdateProductTransactionModal_{{@index}}">
                  Edit
                </button>
              </div>
              <div class="col-md-6">
                <form action="/delete_product" method="post">
                  <input type="submit" class="btn btn-danger btn-sm" onclick="if (!confirm('Are you sure?')) { return false }" class="form-control" value="Delete">
                  <input type="hidden" name="id" value={{ id }}>
                </form>
              </div>
            </div>
          </td>
        </tr>
        <div class="modal fade" id="UpdateProductTransactionModal_{{@index}}" tabindex="-1" aria-labelledby="UpdateModalLabel_{{@index}}" aria-hidden="true">
          <form id="update_product_form_{{@index}}" action="/update_product_by_code" method="post">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="UpdateModalLabel_{{@index}}">Edit Product</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <div class="form-group" style="margin-bottom: 10px;">
                      <input type="text" name="code" class="form-control" value='{{ code }}' readonly>
                  </div>

                  <div class="form-group" style="margin-bottom: 10px;">
                      <input type="text" name="warehouse_code" class="form-control" placeholder="Warehouse Code" value={{ warehouse_code }}>
                  </div>

                  <div class="form-group" style="margin-bottom: 10px;">
                      <input type="text" name="quantity" class="form-control" placeholder="Quantity" value={{ quantity }}>
                  </div>

                  <div class="form-group" style="margin-bottom: 10px;">
                      <input type="text" name="created_date" class="form-control" value={{ created_date }}>
                  </div>

                  <div class="form-group" style="margin-bottom: 10px;">
                      <textarea name="description" class="form-control" placeholder="Description">{{ description }} </textarea>
                  </div>
                  <input type="hidden" name="id" value={{ id }}>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <input type="submit" class="btn btn-primary" value="Confirm">
                </div>
              </div>
            </div>
          </form>
        </div>
        {{/each}}
      </tbody>
    </table>
  </div>
<script src="assets/js/jquery.js"></script>
<script src="assets/js/bootstrap.js"></script>
<script src="assets/js/azara.js"></script>
</body>
</html>